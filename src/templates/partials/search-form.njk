{#- Astra search form (404 page and "no results" page). Submits to <home>?s=…, handled by src/js/search.js. -#}
{%- set f = collections.system.searchForm -%}
<form role="search" method="get" class="search-form" action="{{ homeUrl }}">
	<label for="search-field">
		<span class="screen-reader-text">{{ f.label }}</span>
		<input type="search" id="search-field" class="search-field"   placeholder="{{ f.placeholder }}" value="" name="s">
					<button class="search-submit ast-search-submit" aria-label="{{ f.buttonLabel }}">
				<span hidden>{{ f.button }}</span>
				<i><span class="ast-icon icon-search"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" x="0px" y="0px" viewBox="-893 477 142 142" enable-background="new -888 480 142 142" xml:space="preserve">
						  <path d="M-787.4,568.7h-6.3l-2.4-2.4c7.9-8.7,12.6-20.5,12.6-33.1c0-28.4-22.9-51.3-51.3-51.3  c-28.4,0-51.3,22.9-51.3,51.3c0,28.4,22.9,51.3,51.3,51.3c12.6,0,24.4-4.7,33.1-12.6l2.4,2.4v6.3l39.4,39.4l11.8-11.8L-787.4,568.7  L-787.4,568.7z M-834.7,568.7c-19.7,0-35.5-15.8-35.5-35.5c0-19.7,15.8-35.5,35.5-35.5c19.7,0,35.5,15.8,35.5,35.5  C-799.3,553-815,568.7-834.7,568.7L-834.7,568.7z"/>
						  </svg></span></i>
			</button>
			</label>
			<input type="submit" class="search-submit" value="{{ f.button }}">
	</form>
